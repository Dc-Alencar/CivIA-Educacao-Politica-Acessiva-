<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/pages/modules.css">
</head>
<body class="modules-body">
    
    <main class="modules-container">
        
        <div class="modules-header">
            <h1 class="modules-title">Por onde começar?</h1>
            <p class="modules-subtitle">5 módulos para entender como a política no Brasil funciona.</p>
        </div>

        <div class="modules-list">
            
            <a href="/modulos/1" class="module-card">
                <div class="module-icon">👥</div>
                <div class="module-info">
                    <div class="module-label">MÓDULO 1</div>
                    <div class="module-name">O Cidadão e a Vida em Sociedade</div>
                    <div class="module-desc">Ética, deveres, Constituição e convivência</div>
                </div>
                <div class="module-status">
                    <div class="status-circle status-green">40%</div>
                </div>
            </a>

            <a href="/modulos/2" class="module-card">
                <div class="module-icon">🏛️</div>
                <div class="module-info">
                    <div class="module-label">MÓDULO 2</div>
                    <div class="module-name">A Engrenagem do Estado</div>
                    <div class="module-desc">Poderes, leis, impostos e orçamento público</div>
                </div>
                <div class="module-status">
                    <div class="status-circle status-orange">0%</div>
                </div>
            </a>

            <a href="#" class="module-card disabled" onclick="return false;">
                <div class="module-icon">🗳️</div>
                <div class="module-info">
                    <div class="module-label">MÓDULO 3</div>
                    <div class="module-name">Política, Democracia e Participação</div>
                    <div class="module-desc">Sistemas, ideologias e participação cidadã</div>
                </div>
                <div class="module-status">
                    🔒
                </div>
            </a>

            <a href="#" class="module-card disabled" onclick="return false;">
                <div class="module-icon">💼</div>
                <div class="module-info">
                    <div class="module-label">MÓDULO 4</div>
                    <div class="module-name">Direitos Práticos e Trabalho</div>
                    <div class="module-desc">CLT, consumidor, LGPD e fake news</div>
                </div>
                <div class="module-status">
                    🔒
                </div>
            </a>

            <a href="#" class="module-card disabled" onclick="return false;">
                <div class="module-icon">🛡️</div>
                <div class="module-info">
                    <div class="module-label">MÓDULO 5</div>
                    <div class="module-name">Segurança, Crimes e Ordem Global</div>
                    <div class="module-desc">Crimes comuns, digitais, corrupção e ONU</div>
                </div>
                <div class="module-status">
                    🔒
                </div>
            </a>

        </div>

    </main>

</body>
</html>